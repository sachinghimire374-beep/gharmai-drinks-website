# ============ DATABASE ============
# Default: zero-config SQLite (a local file). Just run db:push + db:seed.
DATABASE_URL="file:./dev.db"
# For production, switch prisma/schema.prisma provider to "postgresql" and use e.g.:
#   Neon:  postgresql://user:pass@ep-xxx.neon.tech/gharmai?sslmode=require

# ============ AUTH (NextAuth) ============
# Generate with:  openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3470"

# ============ SEED ADMIN (used by prisma/seed.ts) ============
SEED_ADMIN_EMAIL="admin@gharmaidrinks.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# ============ WHATSAPP ============
NEXT_PUBLIC_WHATSAPP_NUMBER="9779746302115"

# ============ MEDIA (Cloudinary — optional) ============
# If unset, the app stores uploads in /public/uploads (local dev only).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_UPLOAD_PRESET="gharmai_unsigned"
