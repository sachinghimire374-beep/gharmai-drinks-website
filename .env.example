# ============ DATABASE ============
# Default: zuro-config SQLite (a local file). Just run db:push + db:seed.
DATABASE_URL="file:./dev.db"
# For production, switch prisma/schema.prisma provider to "postgresql" and use e.g.:
#   Neon:  postgresql://user:pass@ep-xxx.neon.tech/gharmai?sslmode=require

# ============ AUTH (NextAuth) ============
# Generate with:  openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3470"

# ============ SEED ADMIN (used by prisma/seed.ts) ============
SEED_ADMIN_EMAIL="your-admin-email@example.com"
SEED_ADMIN_PASSWORD="your-secure-admin-password-here"

# ============ WHATSAPP ============
NEXT_PUBLIC_WHATSAPP_NUMBER="your-whatsapp-number-here"

# ============ MEDIA (Cloudinary ‐ optional) ============
# If unset, the app stores uploads in /public/uploads (local dev only).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_UPLOAD_PRESET="gharmai_unsigned"
